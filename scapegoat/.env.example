# Local Atlas (Docker) — change streams + vector search, no credentials needed.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true

# Hackathon day: replace with the Atlas Hackathon Sandbox connection string.
# The build must live in the sandbox to be eligible for the finalist round.
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=gaslight

