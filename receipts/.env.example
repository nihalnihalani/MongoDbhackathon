# Atlas Hackathon Sandbox connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=receipts

# Select either interchangeable inference provider for all model reviews.
REVIEW_PROVIDER=fireworks
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_SITE_URL=http://localhost:4000
OPENROUTER_APP_NAME=PR-Elo

# Set to "off" to force template verdicts (proof harness uses this; the show
# never depends on an API being up).
REVIEW_LLM=on

# Live GitHub demo. Install a repository webhook for pull_request events at
# https://<public-relay>/webhooks/github and use the same secret here.
GITHUB_WEBHOOK_SECRET=
# Optional locally: when absent, the demo falls back to the authenticated gh CLI.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
PUBLIC_APP_URL=
PORT=4000
