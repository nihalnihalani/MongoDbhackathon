# Atlas Hackathon Sandbox connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=receipts

# Select either interchangeable inference provider for all model reviews.
REVIEW_PROVIDER=fireworks
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_SITE_URL=http://localhost:4000
OPENROUTER_APP_NAME=RECEIPTS

# Set to "off" to force template verdicts (proof harness uses this; the show
# never depends on an API being up).
REVIEW_LLM=on
