# Select either interchangeable inference provider.
MURMUR_PROVIDER=fireworks

FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2-instruct-0905

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=MURMUR

# Optional tuning
MURMUR_MAX_STEPS=12
MURMUR_REQUEST_TIMEOUT_MS=120000
MURMUR_MAX_RETRIES=2
